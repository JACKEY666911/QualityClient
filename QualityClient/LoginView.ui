}
QLineEdit#userNameInput
{
	background-color: transparent;
    font-size:28px;
	border:0px;
	color: rgba(255, 255, 255, 255);
	font-weight:bold;
	font-family:&quot;Microsoft YaHei&quot;;
}

QWidget#passwordInputWidget
{
		border-bottom-left-radius:5px;
