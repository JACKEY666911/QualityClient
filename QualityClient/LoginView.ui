     <property name="styleSheet">
      <string notr="true">QWidget#widget
{
	background-image:url(:/Images/BG.png)
}
QLabel#titleText
{
	color:qlineargradient(
        x1: 0.5, y1: 0,   /* 起始点：控件中心顶部（对应WPF StartPoint=&quot;0.5,0&quot;） */
        x2: 0.5, y2: 1,   /* 结束点：控件中心底部（对应WPF EndPoint=&quot;0.5,1&quot;） */
        stop: 0 #FFFFFF,  /* 渐变起点：白色（Offset=0.0） */
        stop: 1 #00E1FF   /* 渐变终点：#00E1FF（Offset=1.0） */
    );
	font-size:60px;
	font-weight:bold;
	font-family:&quot;Microsoft YaHei&quot;;
	background:transparent;
}

QComboBox#roleComboBox
{
	border:none;
	border-bottom:2px solid #E0E0E0;
	font-size:16px;
	font-family: &quot;Microsoft YaHei&quot;, sans-serif; 
}

QComboBox#roleComboBox:drop-down
{
	width:30px;
	border:none;
	background-color:transparent;
}

QComboBox#roleComboBox:down-arrow
{
	image:url(:/Images/combobox_btn.png)
}

QComboBox#roleComboBox::down-arrow:on {
    image: url(:/Images/down1.png);
}

QComboBox#roleComboBox QAbstractItemView
{
	background-color: rgb(255, 255, 255);
	border:none;
    border-radius: 0;
    outline: 0px;  
}
QComboBox#roleComboBox QAbstractItemView::Item
{
	height:33px;
	font-size:16px;
	font-family: &quot;Microsoft YaHei&quot;, sans-serif; 
	background-color: rgb(255, 255, 255);
    border:1px solid rgba(174,174,174,0.1);
}

QComboBox#roleComboBox QAbstractItemView::item:hover{ 
  background-color:rgb(0,118,246);
  color:rgb(255, 255, 255);
}
QComboBox#roleComboBox QAbstractItemView::item:selected{
  background-color:rgb(0,118,246);
  color:rgb(255, 255, 255);
}


</string>
