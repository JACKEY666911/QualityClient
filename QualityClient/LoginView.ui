}
QLineEdit#passwordInput
{
	background-color: transparent;
    font-size:28px;
	font-family:&quot;Microsoft YaHei&quot;;
	border:0px;
	color: rgba(255, 255, 255, 255);
	font-weight:bold;
}
QPushButton#loginButton
{
    background-color: rgb(0,94,107);  /* 设置背景色 */
    border-color: rgb(0,94,107);
    font-size: 36px;
	font-family:&quot;Microsoft YaHei&quot;;
	font-weight:bold;
    color: rgb(0,229,255);
    border-radius: 5px;  /* 可选：圆角 */
    padding: 10px 20px;  /* 可选：内边距 */
}

QPushButton#loginButton:pressed
{
	background-color: rgb(0,74,87);    /* 暗一些 */
}
QPushButton#showPassBtn
{
	border:0px;
	background-color: transparent;
}
