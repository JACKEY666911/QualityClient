   <string notr="true">QWidget#titleWidget
{
	background:rgb(17, 117, 149);
}

QLabel#titleLabel
{
	font-size:24px;
	font-family:&quot;Microsoft YaHei&quot;;
	color:white;
	font-weight:bold;
}

QLabel#userNameLabel
{
	font-size:18px;
	font-family:&quot;Microsoft YaHei&quot;;
	color:white;
	font-weight:bold;
}
QPushButton#backButton
{
	background-color:rgb(1, 185, 236);
	font-family:&quot;Microsoft YaHei&quot;;
	font-weight:bold;
    border-radius: 5px;
	color:white;
	font-size:18px;

}

QPushButton#loginoutButton
{
	border:0px;
	background-color:transparent;
	color:transparent;

}

/* --- 1. 下拉框通用美化 (针对你截图中的变量名) --- */
/* 排除 m_channelCheckCombo，对其余 ComboBox 统一美化 */
#m_aiResultCombo, 
#m_channelJudgeCombo, 
#m_imageTypeCombo, 
#m_qcResultCombo, 
#m_qcUserCombo,
#m_channelCheckCombo {
    border: 1px solid #DCDFE6;
    border-radius: 4px;
    padding: 3px 25px 3px 8px; /* 右侧留出空间给箭头 */
    min-height: 24px;
    background-color: white;
    color: #333333;
    font-family: &quot;Microsoft YaHei&quot;;
}

/* 悬浮和获取焦点状态 */
#m_aiResultCombo:hover, #m_imageTypeCombo:hover, #m_qcResultCombo:hover,#m_qcUserCombo:hover,m_channelCheckCombo:hover {
    border: 1px solid #409EFF;
}

/* 下拉按钮样式 */
#m_aiResultCombo::drop-down, #m_imageTypeCombo::drop-down, #m_qcResultCombo::drop-down, 
#m_channelJudgeCombo::drop-down, #m_qcUserCombo::drop-down,#m_channelCheckCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid transparent;
    background: transparent; /* 给下拉箭头一个小底色，类似截图效果 */
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* 下拉箭头图标 (可以使用内建的小三角形) */
#m_aiResultCombo::down-arrow, #m_imageTypeCombo::down-arrow, #m_qcResultCombo::down-arrow ,
#m_channelJudgeCombo::down-arrow, #m_qcUserCombo::down-arrow, #m_channelCheckCombo::down-arrow{
     image: url(:/Images/arrow-Down.png);
      width: 15px; height: 15px;
}
#m_aiResultCombo::down-arrow:on, #m_imageTypeCombo::down-arrow:on, #m_qcResultCombo::down-arrow:on,
#m_channelJudgeCombo::down-arrow:on, #m_qcUserCombo::down-arrow:on, #m_channelCheckCombo::down-arrow:on{
     image: url(:/Images/arrow-On.png);
      width: 15px; height: 15px;
}

/* --- 2. 查询按钮 (蓝色风格) --- */
QPushButton#m_queryButton {
    background-color: #00A0E9;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 5px 20px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#m_queryButton:hover {
    background-color: #33B5ED;
}

QPushButton#m_queryButton:pressed {
    background-color: #008CCB;
}

/* --- 3. 重置按钮 (白底灰框风格) --- */
QPushButton#m_resetButton {
    background-color: #FFFFFF;
    color: #666666;
    border: 1px solid #DCDFE6;
    border-radius: 4px;
    padding: 5px 20px;
    font-size: 15px;
}

QPushButton#m_resetButton:hover {
    background-color: #F5F7FA;
    border-color: #C0C4CC;
}</string>
